# Orbion Technologies Environment Variables Template
# Copy to .env or .env.local for local development. NEVER commit real secrets.

# Canonical Site URL
NEXT_PUBLIC_SITE_URL=https://orbion.in

# Server Port (optional, default: 3000)
PORT=3000

# Node Environment
NODE_ENV=development

# Authentication & Database (Local Development Architecture)
# IMPORTANT: SQLite is for local development.
# Public production deployment requires a remote production database accessible to the server runtime.
DATABASE_URL="file:./prisma/dev.db"
BETTER_AUTH_SECRET="replace-with-a-secure-random-32-byte-secret"
BETTER_AUTH_URL="http://localhost:3000"
