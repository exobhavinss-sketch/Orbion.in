# Orbion Technologies Environment Variables Template
# Copy to .env or .env.local for local development. NEVER commit real secrets or production credentials.

# Canonical Site URL
NEXT_PUBLIC_SITE_URL=https://orbion.in

# Server Port (optional, default: 3000)
PORT=3000

# Node Environment
NODE_ENV=development

# -----------------------------------------------------------------------------
# Neon Auth Configuration
# -----------------------------------------------------------------------------
# Base URL of your Neon Auth service (from Neon Dashboard > Auth > Auth URL)
NEON_AUTH_BASE_URL="https://your-neon-auth-url.neon.tech"

# Cookie signing secret (minimum 32 characters)
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET="your-secure-32-character-random-secret"

# Optional: Neon Auth JWKS URL (from Neon Dashboard > Auth > JWKS URL)
# Note: The @neondatabase/auth SDK automatically resolves JWKS from NEON_AUTH_BASE_URL.
# Configure this only if custom OIDC / JWT verification is required in external services.
# NEON_AUTH_JWKS_URL="https://your-neon-auth-url.neon.tech/.well-known/jwks.json"
