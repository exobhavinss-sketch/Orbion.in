# Orbion Technologies Environment Variables Template
# Copy to .env or .env.local for local development. NEVER commit real secrets or production credentials.

# Canonical Site URL
NEXT_PUBLIC_SITE_URL=https://orbion.in

# Server Port (optional, default: 3000)
PORT=3000

# Node Environment
NODE_ENV=development

# -----------------------------------------------------------------------------
# Supabase PostgreSQL Configuration
# -----------------------------------------------------------------------------
# Connect to Postgres via the shared transaction-mode pooler (port 6543, IPv4-only)
# NOTE: Replace YOUR_ENCODED_PASSWORD with your URL-encoded password (e.g. '@' -> '%40').
# DO NOT include literal square brackets '[' or ']' around your password.
DATABASE_URL="postgresql://postgres.bluiiroifqfjqmjkcksc:YOUR_ENCODED_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (port 5432, used for Prisma migrations)
DIRECT_URL="postgresql://postgres.bluiiroifqfjqmjkcksc:YOUR_ENCODED_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# Better Auth Configuration
# -----------------------------------------------------------------------------
# BETTER_AUTH_SECRET: A random 32-byte secret string for token signing and hashing.
# Generate locally via: openssl rand -hex 32
BETTER_AUTH_SECRET="your-32-byte-secret-here"

# BETTER_AUTH_URL: Base URL of your application auth endpoints.
# Local: http://localhost:3000 | Production: https://orbion.in
BETTER_AUTH_URL="https://orbion.in"
