# Orbion Production Environment Variables
# Copy to .env.local for local development overrides

# Canonical site URL
NEXT_PUBLIC_SITE_URL=https://orbion.in

# Server Port (optional, default: 3000)
PORT=3000

# Node Environment
NODE_ENV=production

# Static Export Flag (optional, set to "true" to force static HTML export)
# OUTPUT_EXPORT=false
